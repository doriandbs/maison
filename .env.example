# Copier en .env et adapter. Aucune valeur par défaut n'est fournie pour les secrets.

# --- Django ---
SECRET_KEY=changez-moi
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# En production : https://maison.example.org
CSRF_TRUSTED_ORIGINS=

# --- Base de données (PostgreSQL 16) ---
DATABASE_URL=postgres://maison:maison@localhost:5432/maison

# --- Fichiers déposés (documents) ---
# Dossier hors du dépôt, sauvegardé avec la base. Jamais servi directement par nginx.
MEDIA_ROOT=./media
TAILLE_MAX_DOCUMENT_MO=10

# --- E-mail ---
# Sans EMAIL_HOST ni EMAIL_URL, les e-mails s'affichent dans la console (développement).
# Production, au choix :
#  - variables séparées (prioritaires si EMAIL_HOST est renseigné) :
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=identifiant
# EMAIL_HOST_PASSWORD=cle-smtp
# EMAIL_USE_TLS=true
#  - ou une seule URL (le « @ » d'un identifiant s'y écrit %40) :
# EMAIL_URL=smtp+tls://identifiant:cle-smtp@smtp-relay.brevo.com:587
DEFAULT_FROM_EMAIL=Maison <maison@localhost>

# --- Sécurité ---
# Code à 6 chiffres (application d'authentification) exigé après le mot de passe.
DOUBLE_AUTH_OBLIGATOIRE=True
# Adresse de l'admin Django (avec la barre finale). En production, prendre une valeur imprévisible.
ADMIN_CHEMIN=admin/

# --- Application ---
# Autorise la création de compte par n'importe quel visiteur.
INSCRIPTION_OUVERTE=True
# True derrière nginx : l'adresse du client est lue dans X-Forwarded-For, que nginx doit
# écraser (voir deploy/nginx/maison.conf).
DERRIERE_PROXY=False
# Redirection HTTPS, cookies sécurisés et HSTS. Par défaut : activé si DEBUG=False.
# HTTPS_OBLIGATOIRE=True
