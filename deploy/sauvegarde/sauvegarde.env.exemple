# Configuration des sauvegardes : copier en /etc/maison/sauvegarde.env (root, mode 600).
#   sudo install -m 600 deploy/sauvegarde/sauvegarde.env.exemple /etc/maison/sauvegarde.env
# Ajouter, retirer ou changer une destination se fait ici, sans toucher au code.

# Base PostgreSQL et dossier des documents à sauvegarder.
BASE=maison
MEDIA_ROOT=/var/lib/maison/media
DOSSIER_TRAVAIL=/var/lib/maison/sauvegarde

# Mot de passe de chiffrement restic, commun aux dépôts. À CONSERVER AUSSI HORS DU SERVEUR
# (gestionnaire de mots de passe) : sans lui, les sauvegardes sont illisibles.
#   sudo sh -c 'head -c 32 /dev/urandom | base64 > /etc/maison/restic.motdepasse; chmod 600 /etc/maison/restic.motdepasse'
RESTIC_PASSWORD_FILE=/etc/maison/restic.motdepasse

# Rétention : 7 quotidiennes, 4 hebdomadaires, 12 mensuelles.
CONSERVER="--keep-daily 7 --keep-weekly 4 --keep-monthly 12"

# --- Dépôt 1 : stockage objet S3 (vide = désactivé) ---
# OVH       : s3:https://s3.gra.io.cloud.ovh.net/<bucket>/maison
# Scaleway  : s3:https://s3.fr-par.scw.cloud/<bucket>/maison
# Backblaze : s3:https://s3.eu-central-003.backblazeb2.com/<bucket>/maison
DEPOT_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Dépôt 2 : NAS local (vide = désactivé) ---
# SFTP   : sftp:sauvegarde@nas.local:/volume1/sauvegardes/maison
#          (clé SSH de root sans phrase de passe, hôte connu : sudo ssh sauvegarde@nas.local une fois)
# rclone : rclone:nas:sauvegardes/maison   (remote « nas » configuré par sudo rclone config)
DEPOT_NAS=
